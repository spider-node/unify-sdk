<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- BOM 不继承 parent，避免把 parent 中的测试依赖版本泄漏给使用方 -->
    <groupId>com.unify</groupId>
    <artifactId>unify-bom</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Unify SDK :: BOM</name>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.unify</groupId>
                <artifactId>unify-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.unify</groupId>
                <artifactId>unify-spi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.unify</groupId>
                <artifactId>unify-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.unify</groupId>
                <artifactId>unify-test-kit</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.unify</groupId>
                <artifactId>unify-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
